"""Repository rule that generates the `@micronaut` building-block targets."""

load(
    ":features.bzl",
    "FEATURES",
    "PROCESSOR_CLASSES",
    "RUNTIMES",
    "TEST_JUNIT5",
    "coordinate_to_target_name",
)

_MACRO_TARGETS = ["core", "core_runtime", "test_junit5"] + ["runtime_" + r for r in RUNTIMES]

_PACKAGE = """
package(default_visibility = ["//visibility:public"])
"""

_HEADER = """\
# Generated by @rules_micronaut//micronaut:extensions.bzl. Do not edit.
load("@rules_java//java:java_library.bzl", "java_library")
load("@rules_java//java:java_plugin.bzl", "java_plugin")
""" + _PACKAGE

_UNCONFIGURED = """\
# Generated by @rules_micronaut//micronaut:extensions.bzl. Do not edit.
# No root module called micronaut.maven(), so every target fails analysis
# with an explanatory message.
package(default_visibility = ["//visibility:public"])

[
    alias(
        name = name,
        actual = "@rules_micronaut//micronaut/private:unconfigured",
    )
    for name in {names}
]
"""

def _labels(maven_repo, coordinates):
    # The repository name comes from the configured Maven label.
    # buildifier: disable=canonical-repository
    return ["@@%s//:%s" % (maven_repo, coordinate_to_target_name(c)) for c in coordinates]

def _fmt(labels):
    if not labels:
        return "[]"
    return "[\n" + "".join(["        %r,\n" % label for label in labels]) + "    ]"

def _java_library(name, exports = [], runtime_deps = [], exported_plugins = [], neverlink = False):
    lines = ["java_library(", "    name = %r," % name]
    if exports:
        lines.append("    exports = %s," % _fmt(exports))
    if runtime_deps:
        lines.append("    runtime_deps = %s," % _fmt(runtime_deps))
    if exported_plugins:
        lines.append("    exported_plugins = %s," % _fmt(exported_plugins))
    if neverlink:
        lines.append("    neverlink = True,")
    lines.append(")")
    return "\n".join(lines) + "\n"

def _target_names():
    return (["core", "core_runtime", "processors", "test_junit5"] +
            ["runtime_" + r for r in RUNTIMES] +
            [f for f in FEATURES if f != "core"] +
            ["_macro_" + name for name in _MACRO_TARGETS])

def _micronaut_repo_impl(rctx):
    if not rctx.attr.maven_repo:
        rctx.file("BUILD.bazel", _UNCONFIGURED.format(names = repr(_target_names())))
        return

    repo = rctx.attr.maven_repo
    processor_deps = _labels(repo, FEATURES["core"].processors)

    out = [_HEADER]

    # Core entry points run during normal compilation. Features that expose
    # generated types contribute API-generating entry points separately, so
    # ordinary libraries can compile headers without annotation processing.
    micronaut_plugins = []
    for i, cls in enumerate(PROCESSOR_CLASSES):
        name = "_processor_%d_%s" % (i, cls.rsplit(".", 1)[1])
        micronaut_plugins.append(":" + name)
        out.append("""\
java_plugin(
    name = %r,
    processor_class = %r,
    generates_api = False,
    visibility = ["//visibility:private"],
    deps = %s,
)
""" % (name, cls, _fmt(processor_deps)))

    # Header jars omit private methods, so Micronaut would never call a private
    # injection or lifecycle method for a subclass in another target. Reject
    # them where they are declared, the only compilation that sees them.
    micronaut_plugins.append(":_private_injection_checker")
    out.append("""\
java_plugin(
    name = "_private_injection_checker",
    processor_class = "rules_micronaut.checks.PrivateInjectionChecker",
    visibility = ["//visibility:private"],
    deps = ["@rules_micronaut//micronaut/private/checks:private_injection_checker"],
)
""")

    # Core processors alone, for custom Java wrappers that do their own API
    # and runtime wiring.
    out.append(_java_library("processors", exported_plugins = micronaut_plugins, neverlink = True))

    # `core` is the main entry point: depending on it gives a target the
    # Micronaut API and runs the processors over its sources, in the same way
    # as `@maven//:com_google_auto_value_auto_value` + exported_plugins.
    out.append(_java_library(
        "core",
        exports = _labels(repo, FEATURES["core"].api) + [":processors"],
        runtime_deps = _labels(repo, FEATURES["core"].runtime),
    ))

    # Runtime half of `core`, under a separate label so that macros can add it
    # even when the user also lists `core` in deps.
    out.append(_java_library("core_runtime", runtime_deps = [":core"]))

    # Define all feature targets. Unused features do not resolve their Maven
    # labels or contribute processors/runtime jars to other targets.
    for f in FEATURES:
        if f == "core":
            continue
        feature = FEATURES[f]
        plugins = []
        processor_classes = feature.processor_classes
        feature_processor_deps = _labels(repo, feature.processors)
        if feature.generates_api and not processor_classes:
            # Visitor jars alone cannot start annotation processing. Include
            # Micronaut's entry points and implementation on the API processor
            # path. Bazel deduplicates the entry points in normal compilation.
            processor_classes = PROCESSOR_CLASSES
            feature_processor_deps += processor_deps
        for i, processor_class in enumerate((processor_classes or [None]) if feature.processors else []):
            plugin = "_" + f + "_processor_" + str(i)
            plugins.append(":" + plugin)

            # Other visitors are discovered by core during normal compilation.
            # Standalone processors retain their own entry points and only run
            # in header compilation when the feature explicitly enables it.
            processor_class_line = "    processor_class = %r,\n" % processor_class if processor_class else ""
            out.append("""\
java_plugin(
    name = %r,
%s\
    generates_api = %r,
    visibility = ["//visibility:private"],
    deps = %s,
)
""" % (plugin, processor_class_line, feature.generates_api, _fmt(feature_processor_deps)))
        exports = _labels(repo, feature.api) + [":" + included for included in feature.includes] + [":core"]
        if feature.compile_only:
            compile_only = "_" + f + "_compile_only"
            out.append(_java_library(compile_only, exports = _labels(repo, feature.compile_only), neverlink = True))
            exports.append(":" + compile_only)
        out.append(_java_library(
            f,
            exports = exports,
            runtime_deps = _labels(repo, feature.runtime),
            exported_plugins = plugins,
        ))

    for runtime, coordinates in RUNTIMES.items():
        out.append(_java_library("runtime_" + runtime, runtime_deps = _labels(repo, coordinates)))
    out.append(_java_library(
        "test_junit5",
        exports = _labels(repo, TEST_JUNIT5.api),
        runtime_deps = _labels(repo, TEST_JUNIT5.runtime),
    ))

    # Distinct labels let callers also list the public targets, including in
    # select(). Legacy macros need these aliases visible to callers; the
    # _macro_ prefix reserves them for internal use.
    for name in _MACRO_TARGETS:
        out.append("""\
alias(
    name = %r,
    actual = %r,
)
""" % ("_macro_" + name, ":" + name))

    rctx.file("BUILD.bazel", "\n".join(out))

micronaut_repo = repository_rule(
    implementation = _micronaut_repo_impl,
    attrs = {
        "maven_repo": attr.string(doc = "Canonical name of the rules_jvm_external repo. Empty means unconfigured."),
    },
    doc = "Generates `@micronaut` targets that point into a user-owned Maven repo. Performs no downloads.",
)
