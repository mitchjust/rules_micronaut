"""Full class jars for dependencies whose header jars are not enough.

Bazel compiles a target against its dependencies' header jars. The Micronaut
rules retain private fields through MICRONAUT_JAVACOPTS. Features that expose
generated types also run their processors during header compilation. A header
jar still omits:

- private methods, so Micronaut misses a private `@Inject` or `@PostConstruct`
  method inherited from a superclass in another target;
- private fields of targets compiled without MICRONAUT_JAVACOPTS;
- types generated by processors that do not run in header compilation, including
  Hibernate's metamodel generator and Lombok.

`micronaut_full_jar_deps` re-exports its deps with their full class jars first
on the compile classpath. Jars from rules_jvm_external are never stripped and
need no wrapping.
"""

load("@rules_java//java/common:java_common.bzl", "java_common")
load("@rules_java//java/common:java_info.bzl", "JavaInfo")
load("@rules_java//java/common:proguard_spec_info.bzl", "ProguardSpecInfo")

def _full_jar_info(infos):
    deps = java_common.merge(infos)
    full = [
        JavaInfo(output_jar = jar, compile_jar = jar, neverlink = True)
        for jar in deps.full_compile_jars.to_list()
    ]

    # javac resolves a class from its first classpath entry.
    return java_common.merge(full + [deps])

def _micronaut_full_jar_deps_impl(ctx):
    return [_full_jar_info([dep[JavaInfo] for dep in ctx.attr.deps])]

def _full_jar_library_impl(ctx):
    actual = ctx.attr.actual
    providers = [
        _full_jar_info([actual[JavaInfo]]),
        actual[DefaultInfo],
        coverage_common.instrumented_files_info(ctx, dependency_attributes = ["actual"]),
    ]
    for provider in [OutputGroupInfo, ProguardSpecInfo]:
        if provider in actual:
            providers.append(actual[provider])
    return providers

# The public target of micronaut_library(export_full_jar = True). Unlike a dependency
# bundle, it also preserves the underlying library's outputs and runfiles.
full_jar_library = rule(
    implementation = _full_jar_library_impl,
    attrs = {
        "actual": attr.label(mandatory = True, providers = [JavaInfo]),
    },
    provides = [JavaInfo],
)

micronaut_full_jar_deps = rule(
    implementation = _micronaut_full_jar_deps_impl,
    attrs = {
        "deps": attr.label_list(
            providers = [JavaInfo],
            doc = "Java targets to expose through their full class jars, including the targets they export.",
        ),
    },
    provides = [JavaInfo],
    doc = """Re-exports `deps`, compiling dependants against full class jars instead of header jars.

Use it in place of a dependency when Micronaut must see its private methods or
types generated by a processor that does not run in header compilation:

```starlark
micronaut_full_jar_deps(
    name = "entities_full",
    deps = [":entities"],
)

micronaut_library(
    name = "queries",
    srcs = ["Queries.java"],
    deps = [":entities_full"],
)
```

Runtime dependencies and exported annotation processors are unchanged. Targets
depending on `queries` also compile against the full jars, and are recompiled
whenever `entities` changes, so wrap only the targets that need it.""",
)
