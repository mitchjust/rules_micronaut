load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "jakarta-el",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:jakarta_el"],
)

micronaut_test(
    name = "JakartaElTest",
    srcs = ["src/test/java/com/example/jakartael/JakartaElTest.java"],
    runtime = "none",
    runtime_deps = ["//:test_logging"],
    deps = [
        ":jakarta-el",
        "@micronaut//:jakarta_el",
    ],
)

test_suite(
    name = "tests",
    tests = [":JakartaElTest"],
    visibility = ["//features:__pkg__"],
)
