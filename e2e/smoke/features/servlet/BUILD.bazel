load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "servlet",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:servlet"],
)

micronaut_test(
    name = "jetty_test",
    srcs = ["src/test/java/com/example/servlet/ServletTest.java"],
    runtime = "jetty",
    test_class = "com.example.servlet.ServletTest",
    runtime_deps = [
        "//:test_logging",
        "@micronaut//:serialization_jackson",
    ],
    deps = [
        ":servlet",
        "@maven//:io_micronaut_micronaut_http_server",
        "@micronaut//:http",
    ],
)

micronaut_test(
    name = "tomcat_test",
    srcs = ["src/test/java/com/example/servlet/ServletTest.java"],
    runtime = "tomcat",
    test_class = "com.example.servlet.ServletTest",
    runtime_deps = [
        "//:test_logging",
        "@micronaut//:serialization_jackson",
    ],
    deps = [
        ":servlet",
        "@maven//:io_micronaut_micronaut_http_server",
        "@micronaut//:http",
    ],
)

micronaut_test(
    name = "undertow_test",
    srcs = ["src/test/java/com/example/servlet/ServletTest.java"],
    runtime = "undertow",
    test_class = "com.example.servlet.ServletTest",
    runtime_deps = [
        "//:test_logging",
        "@micronaut//:serialization_jackson",
    ],
    deps = [
        ":servlet",
        "@maven//:io_micronaut_micronaut_http_server",
        "@micronaut//:http",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":jetty_test",
        ":tomcat_test",
        ":undertow_test",
    ],
    visibility = ["//features:__pkg__"],
)
