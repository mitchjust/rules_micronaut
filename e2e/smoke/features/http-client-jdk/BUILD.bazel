load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "http-client-jdk",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:http_client_jdk"],
)

micronaut_test(
    name = "JdkHttpClientTest",
    srcs = ["src/test/java/com/example/httpclientjdk/JdkHttpClientTest.java"],
    runtime_deps = [
        "//:test_logging",
        "@micronaut//:serialization_jackson",
    ],
    deps = [
        ":http-client-jdk",
        "@micronaut//:http_client_jdk",
    ],
)

test_suite(
    name = "tests",
    tests = [":JdkHttpClientTest"],
    visibility = ["//features:__pkg__"],
)
