load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "multi-tenancy",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:multi_tenancy"],
)

micronaut_test(
    name = "MultiTenancyTest",
    srcs = ["src/test/java/com/example/multitenancy/MultiTenancyTest.java"],
    runtime = "none",
    runtime_deps = ["//:test_logging"],
    deps = [
        ":multi-tenancy",
        "@micronaut//:multi_tenancy",
    ],
)

test_suite(
    name = "tests",
    tests = [":MultiTenancyTest"],
    visibility = ["//features:__pkg__"],
)
