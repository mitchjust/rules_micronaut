load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "data-jpa-metamodel",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:data_jpa_metamodel"],
)

micronaut_test(
    name = "JpaMetamodelTest",
    srcs = ["src/test/java/com/example/datajpametamodel/JpaMetamodelTest.java"],
    runtime = "none",
    runtime_deps = ["//:test_logging"],
    deps = [
        ":data-jpa-metamodel",
        "@micronaut//:data_jpa_metamodel",
    ],
)

test_suite(
    name = "tests",
    tests = [":JpaMetamodelTest"],
    visibility = ["//features:__pkg__"],
)
