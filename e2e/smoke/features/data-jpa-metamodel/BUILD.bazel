load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library")

micronaut_library(
    name = "data-jpa-metamodel",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = ["src/main/java/com/example/datajpametamodel/GeneratedTypes.java"],
    ),
    deps = ["@micronaut//:data_jpa_metamodel"],
)

# Compile a separate consumer so missing processor output fails the build.
micronaut_library(
    name = "generated-code",
    srcs = ["src/main/java/com/example/datajpametamodel/GeneratedTypes.java"],
    deps = [
        ":data-jpa-metamodel",
        "@micronaut//:data_jpa_metamodel",
    ],
)

build_test(
    name = "tests",
    targets = [":generated-code"],
    visibility = ["//features:__pkg__"],
)
