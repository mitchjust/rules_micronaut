load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_micronaut//micronaut:defs.bzl", "micronaut_full_jar_deps", "micronaut_library")

micronaut_library(
    name = "data-spring-jdbc",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = ["src/main/java/com/example/springjdbc/GeneratedTypes.java"],
    ),
    deps = ["@micronaut//:data_spring_jdbc"],
)

# Compile a separate consumer so missing processor output fails the build. It
# names generated implementation classes, which only the full jar contains.
micronaut_full_jar_deps(
    name = "full",
    deps = [":data-spring-jdbc"],
)

micronaut_library(
    name = "generated-code",
    srcs = ["src/main/java/com/example/springjdbc/GeneratedTypes.java"],
    deps = [
        ":full",
        "@micronaut//:data_spring_jdbc",
    ],
)

build_test(
    name = "tests",
    targets = [":generated-code"],
    visibility = ["//features:__pkg__"],
)
