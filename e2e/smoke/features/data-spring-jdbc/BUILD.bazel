load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "data-spring-jdbc",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:data_spring_jdbc"],
)

micronaut_test(
    name = "SpringJdbcTest",
    srcs = ["src/test/java/com/example/springjdbc/SpringJdbcTest.java"],
    runtime = "none",
    runtime_deps = [
        "//:test_logging",
        "@maven//:com_h2database_h2",
        "@maven//:io_micronaut_sql_micronaut_jdbc_hikari",
    ],
    deps = [
        ":data-spring-jdbc",
        "@micronaut//:data_spring_jdbc",
    ],
)

test_suite(
    name = "tests",
    tests = [":SpringJdbcTest"],
    visibility = ["//features:__pkg__"],
)
