load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "validation",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "@micronaut//:http",
        "@micronaut//:validation",
    ],
)

micronaut_test(
    name = "ValidationTest",
    srcs = ["src/test/java/com/example/ValidationTest.java"],
    # HTTP validation errors need a JSON mapper at runtime.
    runtime_deps = [
        "@micronaut//:serialization_jackson",
    ],
    deps = [
        ":validation",
        "@micronaut//:http_client",
    ],
)

test_suite(
    name = "tests",
    tests = [":ValidationTest"],
    visibility = ["//features:__pkg__"],
)
