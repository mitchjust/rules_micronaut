load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "data-hibernate-reactive",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        # This repository explicitly uses ReactorCrudRepository and Mono.
        "@maven//:io_projectreactor_reactor_core",
        "@micronaut//:data_hibernate_reactive",
    ],
)

micronaut_test(
    name = "HibernateReactiveTest",
    srcs = ["src/test/java/com/example/hibernatereactive/HibernateReactiveTest.java"],
    runtime = "none",
    runtime_deps = ["@maven//:io_vertx_vertx_pg_client"],
    deps = [
        ":data-hibernate-reactive",
        "@maven//:io_projectreactor_reactor_core",
        "@maven//:org_testcontainers_testcontainers_junit_jupiter",
        "@maven//:org_testcontainers_testcontainers_postgresql",
        "@micronaut//:data_hibernate_reactive",
    ],
)

test_suite(
    name = "tests",
    tests = [":HibernateReactiveTest"],
    visibility = ["//features:__pkg__"],
)
