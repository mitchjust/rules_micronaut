load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "data-mongodb",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:data_mongodb"],
)

micronaut_test(
    name = "MongoDbTest",
    srcs = ["src/test/java/com/example/datamongodb/MongoDbTest.java"],
    runtime = "none",
    tags = ["requires-docker"],
    runtime_deps = [
        "//:test_logging",
        "@maven//:org_mongodb_mongodb_driver_sync",
    ],
    deps = [
        ":data-mongodb",
        "@maven//:io_micronaut_serde_micronaut_serde_bson",
        "@maven//:org_testcontainers_testcontainers",
        "@maven//:org_testcontainers_testcontainers_junit_jupiter",
        "@maven//:org_testcontainers_testcontainers_mongodb",
        "@micronaut//:data_mongodb",
    ],
)

test_suite(
    name = "tests",
    tests = [":MongoDbTest"],
    visibility = ["//features:__pkg__"],
)
