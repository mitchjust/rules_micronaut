load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "data-azure-cosmos",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@micronaut//:data_azure_cosmos"],
)

micronaut_test(
    name = "CosmosTest",
    size = "large",
    srcs = ["src/test/java/com/example/dataazurecosmos/CosmosTest.java"],
    runtime = "none",
    tags = ["requires-docker"],
    # Reactor Netty probes QUIC even in gateway mode; the resolved HTTP/3 closure omits it.
    runtime_deps = [
        "//:test_logging",
        "@maven//:io_netty_netty_codec_classes_quic",
    ],
    deps = [
        ":data-azure-cosmos",
        "@maven//:io_micronaut_micronaut_json_core",
        "@maven//:org_testcontainers_testcontainers",
        "@maven//:org_testcontainers_testcontainers_azure",
        "@maven//:org_testcontainers_testcontainers_junit_jupiter",
        "@micronaut//:data_azure_cosmos",
    ],
)

test_suite(
    name = "tests",
    tests = [":CosmosTest"],
    visibility = ["//features:__pkg__"],
)
