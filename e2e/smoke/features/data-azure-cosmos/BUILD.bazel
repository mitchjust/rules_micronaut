load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library")

micronaut_library(
    name = "data-azure-cosmos",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = ["src/main/java/com/example/dataazurecosmos/GeneratedTypes.java"],
    ),
    # The consumer names generated implementation classes absent from header jars.
    export_full_jar = True,
    deps = ["@micronaut//:data_azure_cosmos"],
)

# Compile a separate consumer so missing processor output fails the build.
micronaut_library(
    name = "generated-code",
    srcs = ["src/main/java/com/example/dataazurecosmos/GeneratedTypes.java"],
    deps = [
        ":data-azure-cosmos",
        "@micronaut//:data_azure_cosmos",
    ],
)

build_test(
    name = "tests",
    targets = [":generated-code"],
    visibility = ["//features:__pkg__"],
)
