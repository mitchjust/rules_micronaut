load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "hibernate-jpamodelgen",
    srcs = glob(["src/main/java/**/*.java"]),
    # Hibernate's processor cannot run in header compilation.
    export_full_jar = True,
    deps = [
        "@micronaut//:hibernate_jpamodelgen",
    ],
)

micronaut_test(
    name = "HibernateMetamodelTest",
    srcs = ["src/test/java/com/example/hibernatejpamodelgen/HibernateMetamodelTest.java"],
    runtime = "none",
    deps = [
        ":hibernate-jpamodelgen",
        "@micronaut//:hibernate_jpamodelgen",
    ],
)

test_suite(
    name = "tests",
    tests = [":HibernateMetamodelTest"],
    visibility = ["//features:__pkg__"],
)
