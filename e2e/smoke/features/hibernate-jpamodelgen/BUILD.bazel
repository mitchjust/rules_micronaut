load("@rules_micronaut//micronaut:defs.bzl", "micronaut_full_jar_deps", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "hibernate-jpamodelgen",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "@micronaut//:hibernate_jpamodelgen",
    ],
)

# Hibernate's processor cannot run in header compilation, so the metamodel is
# only in the full jar.
micronaut_full_jar_deps(
    name = "metamodel",
    deps = [":hibernate-jpamodelgen"],
)

micronaut_test(
    name = "HibernateMetamodelTest",
    srcs = ["src/test/java/com/example/hibernatejpamodelgen/HibernateMetamodelTest.java"],
    runtime = "none",
    deps = [
        ":metamodel",
        "@micronaut//:hibernate_jpamodelgen",
    ],
)

test_suite(
    name = "tests",
    tests = [":HibernateMetamodelTest"],
    visibility = ["//features:__pkg__"],
)
