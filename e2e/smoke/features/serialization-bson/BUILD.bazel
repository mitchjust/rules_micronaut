load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "serialization-bson",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "@micronaut//:serialization",
    ],
)

micronaut_test(
    name = "SerdeBsonTest",
    srcs = ["src/test/java/com/example/serdebson/SerdeBsonTest.java"],
    runtime = "none",
    runtime_deps = ["@micronaut//:serialization_bson"],
    deps = [
        ":serialization-bson",
        "//features/serialization",
        "@maven//:io_micronaut_serde_micronaut_serde_bson",
        "@micronaut//:serialization",
    ],
)

test_suite(
    name = "tests",
    tests = [":SerdeBsonTest"],
    visibility = ["//features:__pkg__"],
)
