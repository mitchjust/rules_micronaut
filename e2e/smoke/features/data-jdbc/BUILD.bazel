load("@rules_micronaut//micronaut:defs.bzl", "micronaut_library", "micronaut_test")

micronaut_library(
    name = "data-jdbc",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "@micronaut//:data_jdbc",
        "@micronaut//:serialization",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":BookRepositoryTest",
        ":NoPoolTest",
    ],
    visibility = ["//features:__pkg__"],
)

# Adding any of these features must leave the pool and driver to the application.
micronaut_test(
    name = "NoPoolTest",
    srcs = ["src/test/java/com/example/data/NoPoolTest.java"],
    runtime = "none",
    deps = [
        "@micronaut//:data_jdbc",
        "@micronaut//:data_jpa",
        "@micronaut//:data_spring_jdbc",
    ],
)

micronaut_test(
    name = "BookRepositoryTest",
    srcs = ["src/test/java/com/example/data/BookRepositoryTest.java"],
    resources = glob(["src/test/resources/**"]),
    runtime_deps = [
        "@maven//:com_h2database_h2",
        "@maven//:io_micronaut_sql_micronaut_jdbc_hikari",
        "@maven//:org_yaml_snakeyaml",
        "@micronaut//:serialization_jackson",
    ],
    deps = [
        ":data-jdbc",
        "@micronaut//:data_jdbc",
    ],
)
