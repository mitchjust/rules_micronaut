"""End-to-end smoke test: a Micronaut HTTP app with a @MicronautTest, built against rules_micronaut."""

bazel_dep(name = "rules_micronaut", version = "0.0.0")
local_path_override(
    module_name = "rules_micronaut",
    path = "../..",
)

bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# JSON-P specifies an API, not a provider. Each test selects its provider below.
maven.artifact(
    artifact = "micronaut-serde-jsonp",
    exclusions = ["org.eclipse.parsson:parsson"],
    group = "io.micronaut.serde",
)
maven.install(
    artifacts = [
        # core
        "io.micronaut:micronaut-inject",
        "io.micronaut:micronaut-inject-java",
        "io.micronaut:micronaut-core",
        "io.micronaut:micronaut-context",
        # Not managed by the platform BOM; matches micronaut-inject's own dependency.
        "jakarta.inject:jakarta.inject-api:2.0.1",
        "jakarta.annotation:jakarta.annotation-api",
        "io.micronaut.sourcegen:micronaut-sourcegen-annotations",
        # http
        "io.micronaut:micronaut-http",
        "io.micronaut:micronaut-http-validation",
        "io.micronaut:micronaut-http-server-netty",
        "io.micronaut:micronaut-http-client",
        "io.micronaut:micronaut-http-client-core",
        # serde
        "io.micronaut.serde:micronaut-serde-api",
        "io.micronaut.serde:micronaut-serde-processor",
        "io.micronaut.serde:micronaut-serde-jackson",
        # validation
        "io.micronaut.validation:micronaut-validation",
        "io.micronaut.validation:micronaut-validation-processor",
        "jakarta.validation:jakarta.validation-api",
        # security
        "io.micronaut.security:micronaut-security",
        "io.micronaut.security:micronaut-security-annotations",
        "io.micronaut.security:micronaut-security-processor",
        # aop (part of core)
        "io.micronaut:micronaut-aop",
        # data_jdbc
        "io.micronaut.data:micronaut-data-model",
        "io.micronaut.data:micronaut-data-jdbc",
        "io.micronaut.data:micronaut-data-processor",
        "io.micronaut.sql:micronaut-jdbc-hikari",
        "com.h2database:h2",
        # Cache annotations use core AOP; select the Caffeine backend directly.
        "io.micronaut.cache:micronaut-cache-core",
        "io.micronaut.cache:micronaut-cache-caffeine",
        # micronaut-sourcegen @Builder (wired on //features/core/base through plugins)
        "io.micronaut.sourcegen:micronaut-sourcegen-generator-java",
        # Processor-backed features and their local test implementations.
        "io.micronaut.openapi:micronaut-openapi",
        "io.micronaut.openapi:micronaut-openapi-annotations",
        "io.swagger.core.v3:swagger-annotations",
        "io.micronaut.openapi:micronaut-openapi-adoc",
        "io.micronaut.jsonschema:micronaut-json-schema-annotations",
        "io.micronaut.jsonschema:micronaut-json-schema-processor",
        "org.mongodb:bson",
        "io.micronaut.serde:micronaut-serde-bson",
        "jakarta.json:jakarta.json-api",
        "org.eclipse.parsson:parsson:1.1.9",
        "org.apache.johnzon:johnzon-core:2.2.0",
        "io.micronaut.data:micronaut-data-hibernate-jpa",
        "jakarta.persistence:jakarta.persistence-api",
        "io.micronaut.data:micronaut-data-r2dbc",
        "io.r2dbc:r2dbc-spi",
        "io.projectreactor:reactor-core",
        "io.micronaut.r2dbc:micronaut-r2dbc-core",
        "com.fasterxml.jackson.core:jackson-annotations",
