        "io.opentelemetry.instrumentation:opentelemetry-instrumentation-annotations",
        "io.micronaut.tracing:micronaut-tracing-annotation",
        "io.micronaut.tracing:micronaut-tracing-opentelemetry-annotation",
        "io.micronaut.tracing:micronaut-tracing-opentelemetry",
        "org.springframework:spring-context",
        "org.springframework:spring-beans",
        "org.springframework:spring-core",
        "io.micronaut.spring:micronaut-spring-annotation",
        "org.springframework:spring-web",
        "io.micronaut:micronaut-http-server",
        "io.micronaut.spring:micronaut-spring-web-annotation",
        "io.micronaut.spring:micronaut-spring-web",
