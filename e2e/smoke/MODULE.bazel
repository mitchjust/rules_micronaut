        "io.micronaut.eclipsestore:micronaut-eclipsestore-annotations",
        "io.micronaut.eclipsestore:micronaut-eclipsestore-processor",
        "info.picocli:picocli",
        "io.micronaut.picocli:micronaut-picocli",
        "info.picocli:picocli-codegen",
        "jakarta.servlet:jakarta.servlet-api",
        "io.micronaut.servlet:micronaut-servlet-processor",
        "io.micronaut.servlet:micronaut-http-server-jetty",
        "io.micronaut.servlet:micronaut-http-server-tomcat",
        "io.micronaut.servlet:micronaut-http-server-undertow",
        "io.r2dbc:r2dbc-h2",
        "io.opentelemetry:opentelemetry-sdk",
        "io.opentelemetry:opentelemetry-sdk-trace",
        "io.opentelemetry:opentelemetry-sdk-testing",
