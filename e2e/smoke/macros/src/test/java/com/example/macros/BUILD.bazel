load("@rules_micronaut//micronaut:defs.bzl", "micronaut_test")

micronaut_test(
    name = "MacroTest",
    # A package-local filename must infer com.example.macros.MacroTest.
    srcs = ["MacroTest.java"],
    data = ["//macros:inline_app"],
    exclude_engines = ["junit-vintage"],
    exclude_tags = ["skipped"],
    include_engines = ["junit-jupiter"],
    include_tags = ["macro"],
    jvm_flags = ["-Dmacro.app=$(rlocationpath //macros:inline_app)"],
    runtime = "none",
    runtime_deps = [
        "//:test_logging",
        "//macros:exported",
        "@micronaut//:core_runtime",
        "@micronaut//:runtime_none",
        "@micronaut//:test_junit5",
    ],
    deps = [
        "//macros:exported",
        "@micronaut//:test_junit5",
        "@rules_java//java/runfiles",
    ],
)

_TEST_DEPS = select({
    "//macros:explicit_core": [
        "//macros:library_select",
        "@micronaut//:core",
        "@micronaut//:test_junit5",
        "@rules_java//java/runfiles",
    ],
    "//conditions:default": [
        "//macros:library_select",
        "@micronaut//:test_junit5",
        "@rules_java//java/runfiles",
    ],
})

micronaut_test(
    name = "MacroTestSelect",
    srcs = ["MacroTest.java"],
    data = ["//macros:inline_app_select"],
    exclude_engines = ["junit-vintage"],
    exclude_tags = ["skipped"],
    include_engines = ["junit-jupiter"],
    include_tags = ["macro"],
    jvm_flags = ["-Dmacro.app=$(rlocationpath //macros:inline_app_select)"],
    runtime = "none",
    test_class = "com.example.macros.MacroTest",
    runtime_deps = _TEST_DEPS + [
        "//:test_logging",
        "@micronaut//:core_runtime",
        "@micronaut//:runtime_none",
    ],
    deps = _TEST_DEPS,
)
